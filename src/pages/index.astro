---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Hr from "@components/Hr.astro";
import ProjectCard from "@components/ProjectCard.astro";
import Socials from "@components/Socials.astro";
import getSortedPosts from "@utils/getSortedPosts";
import getProjects from "@utils/getProjects";
import slugify from "@utils/slugify";
import { LOCALE, SOCIALS } from "@config";

const posts = await getCollection("blog");
const recentPosts = getSortedPosts(posts).slice(0, 4);

const projects = await getProjects();
const featuredProjects = projects.filter(project => project.featured);

const socialCount = SOCIALS.filter(social => social.active).length;

const formatDate = (date: Date) =>
  new Date(date).toLocaleDateString(LOCALE, {
    year: "numeric",
    month: "short",
  });
---

<Layout>
  <Header />
  <main id="main-content">
    <section id="intro">
      <img
        src="/kamrul.jpg"
        alt="MD Kamrul Hassan"
        width="112"
        height="112"
        class="avatar"
      />
      <div class="intro-body">
        <h1>MD Kamrul Hassan</h1>
        <p class="role">Senior Software Engineer at Optimizely</p>
        <p>
          I own backend services for Opal, Optimizely's AI agent platform —
          agent and workflow orchestration, tool calling, and agent memory and
          retrieval — along with the platform infrastructure underneath: Cloud
          Run and Cloud SQL in Terraform, an event bus split into isolated
          brokers, and zero-downtime data model migrations.
        </p>
        <p>
          Outside work I build developer tooling — terminal CLIs, Neovim plugins
          and orchestration for AI coding agents. I write about what I had to
          learn the hard way, some of it in Bengali.
        </p>
        {
          socialCount > 0 && (
            <div class="intro-links">
              <Socials />
              <LinkButton href="/resume" className="resume-link">
                Resume
              </LinkButton>
            </div>
          )
        }
      </div>
    </section>

    <Hr />

    <section id="writing">
      <div class="section-head">
        <h2>Writing</h2>
        <LinkButton href="/posts">All posts &rarr;</LinkButton>
      </div>
      <ul class="post-list">
        {
          recentPosts.map(({ data }) => (
            <li>
              <a href={`/posts/${slugify(data)}`}>
                <span class="post-title">{data.title}</span>
                <span class="post-date">{formatDate(data.pubDatetime)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <Hr />

    <section id="work">
      <div class="section-head">
        <h2>Selected work</h2>
        <LinkButton href="/projects">All projects &rarr;</LinkButton>
      </div>
      <ul class="project-grid">
        {featuredProjects.map(project => <ProjectCard project={project} />)}
      </ul>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  #intro {
    @apply flex flex-col items-start gap-6 pt-8 pb-10 sm:flex-row sm:items-center;
  }
  .avatar {
    @apply h-24 w-24 shrink-0 rounded-full border-2 border-skin-line object-cover sm:h-28 sm:w-28;
  }
  .intro-body h1 {
    @apply text-3xl font-bold sm:text-4xl;
  }
  .role {
    @apply mt-1 text-skin-accent;
  }
  .intro-body > p:not(.role) {
    @apply mt-3 max-w-prose;
  }
  .intro-links {
    @apply mt-4 flex flex-wrap items-center gap-2;
  }
  .intro-links :global(.resume-link) {
    @apply rounded border border-skin-line px-3 py-1 text-sm hover:border-skin-accent;
  }

  #work,
  #writing {
    @apply pt-10 pb-6;
  }
  .section-head {
    @apply mb-5 flex items-baseline justify-between gap-4;
  }
  .section-head h2 {
    @apply text-2xl font-semibold tracking-wide;
  }
  .section-head :global(a) {
    @apply whitespace-nowrap text-sm opacity-80;
  }

  .project-grid {
    @apply grid gap-4 sm:grid-cols-2;
  }

  .post-list li + li {
    @apply border-t border-skin-line;
  }
  .post-list a {
    @apply flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4;
  }
  .post-title {
    @apply font-medium decoration-dashed underline-offset-4;
  }
  .post-list a:hover .post-title {
    @apply text-skin-accent underline;
  }
  .post-date {
    @apply shrink-0 text-sm opacity-70;
  }
</style>
