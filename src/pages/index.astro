---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Ask from "@components/Ask.astro";
import { resume } from "../data/resume";
import getSortedPosts from "@utils/getSortedPosts";
import slugify from "@utils/slugify";
import "@styles/ledger-home.css";
const posts = getSortedPosts(
  await getCollection("blog", ({ data }) => !data.draft)
).slice(0, 4);
const formatDate = (date: Date) =>
  date.toLocaleDateString("en", {
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  });
---

<Layout title={`${resume.name} — Senior Software Engineer`}>
  <main class="ledger-home" id="main-content">
    <Header activeNav="about" />
    <header class="ledger-hero" id="sec-identity">
      <h1>{resume.name}<span class="block" aria-hidden="true"></span></h1>
      <p class="role">
        <strong>Senior Software Engineer</strong> at Optimizely
      </p>
      <p class="experience-summary"><strong>5+</strong> years of experience</p>
      <p class="contact">
        <a href={`mailto:${resume.email}`}>{resume.email}</a> · {
          resume.location
        } · <a href={resume.github} target="_blank" rel="noopener noreferrer"
          >GitHub ↗</a
        > · <a href={resume.linkedin} target="_blank" rel="noopener noreferrer"
          >LinkedIn ↗</a
        > · <a href="/resume">Print résumé</a>
      </p>
      <p class="bio">{resume.bio}</p>
    </header>
    <section id="sec-experience" aria-labelledby="experience-title">
      <div class="label">
        <h2 id="experience-title">Experience</h2><span
          class="n"
          aria-hidden="true">01</span
        >
      </div>
      <div>
        {
          resume.roles.map(job => (
            <div class="job">
              <div class="job-head">
                <>
                  <h3 class="job-title">
                    {job.title} · {job.company}
                  </h3>
                  <span class="job-date">{job.dates}</span>
                </>
              </div>
              {job.note && <p class="job-note">{job.note}</p>}
              <ul>
                {job.bullets.map(text => (
                  <li>{text}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>
    <section id="sec-skills" aria-labelledby="skills-title">
      <div class="label">
        <h2 id="skills-title">Skills</h2><span class="n" aria-hidden="true"
          >02</span
        >
      </div>
      <dl>
        {
          resume.skills.map(skill => (
            <div class="skill">
              <>
                <dt>{skill.label.toLowerCase()}</dt>
                <dd>{skill.text}</dd>
              </>
            </div>
          ))
        }
      </dl>
    </section>
    <section id="sec-projects" aria-labelledby="projects-title">
      <div class="label">
        <h2 id="projects-title">Projects</h2><span class="n" aria-hidden="true"
          >03</span
        >
      </div>
      <div>
        <dl>
          {
            resume.projects.map(project => (
              <div class="proj">
                <>
                  <dt>
                    {project.url ? (
                      <a
                        href={project.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {project.name}
                      </a>
                    ) : (
                      project.name
                    )}
                  </dt>
                  <dd>{project.blurb}</dd>
                </>
              </div>
            ))
          }
        </dl><a class="section-link" href="/projects">All projects →</a>
      </div>
    </section>
    <section id="sec-education" aria-labelledby="education-title">
      <div class="label">
        <h2 id="education-title">Education</h2><span
          class="n"
          aria-hidden="true">04</span
        >
      </div>
      <p class="education">{resume.education}</p>
    </section>
    <section id="sec-writing" aria-labelledby="writing-title">
      <div class="label">
        <h2 id="writing-title">Writing</h2><span class="n" aria-hidden="true"
          >05</span
        >
      </div>
      <div>
        <ul class="posts">
          {
            posts.map(({ data }) => (
              <li>
                <a href={`/posts/${slugify(data)}`}>
                  <>
                    <span>{data.title}</span>
                    <time datetime={data.pubDatetime.toISOString()}>
                      {formatDate(data.pubDatetime)}
                    </time>
                  </>
                </a>
              </li>
            ))
          }
        </ul><a class="section-link" href="/posts">All writing →</a>
      </div>
    </section>
    <footer class="ledger-footer">
      <span>© {new Date().getFullYear()} {resume.name.toUpperCase()}</span><a
        href="/rss.xml">RSS ↗</a
      >
    </footer>
  </main>
  <Ask />
</Layout>
