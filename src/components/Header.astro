---
export interface Props {
  activeNav?: "posts" | "projects" | "tags" | "about" | "search";
}
const { activeNav } = Astro.props;
---

<header class="site-header">
  <a class="skip-link" href="#main-content">Skip to content</a>
  <a class="site-mark" href="/" aria-label="Kamrul Hassan home"
    >KH / Software Engineer</a
  >
  <nav aria-label="Main navigation">
    <a href="/" aria-current={activeNav === "about" ? "page" : undefined}
      >Resume</a
    >
    <a href="/posts" aria-current={activeNav === "posts" ? "page" : undefined}
      >Writing</a
    >
    <a
      href="/projects"
      aria-current={activeNav === "projects" ? "page" : undefined}>Projects</a
    >
    <a href="/search" aria-current={activeNav === "search" ? "page" : undefined}
      >Search</a
    >
    <button id="theme-btn" type="button" aria-label="Switch to light mode"
      >Light mode</button
    >
  </nav>
</header>
<style>
  .site-header {
    max-width: 876px;
    width: calc(100% - 40px);
    margin: 32px auto 0;
    padding: 0 0 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    border-bottom: 3px solid var(--fg);
    font-size: 11px;
  }
  .site-mark {
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    text-decoration: none;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  nav a {
    text-decoration: none;
  }
  nav a:hover,
  nav a[aria-current="page"] {
    text-decoration: underline;
  }
  #theme-btn {
    background: transparent;
    color: var(--fg);
    border: 1px solid var(--fg);
    padding: 3px 8px;
    min-height: 30px;
    text-transform: uppercase;
    font-size: 10px;
    cursor: pointer;
  }
  .skip-link {
    position: absolute;
    top: 4px;
    left: 8px;
    transform: translateY(-180%);
    background: var(--fg);
    color: var(--bg);
    padding: 8px;
    z-index: 10000;
  }
  .skip-link:focus {
    transform: none;
  }
  @media (max-width: 680px) {
    .site-header {
      align-items: start;
      flex-direction: column;
      gap: 12px;
    }
    nav {
      gap: 16px;
    }
  }
</style>
